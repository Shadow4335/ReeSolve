# ReeSolve environment variables: placeholders only. Never commit a real .env (it is gitignored).
# Copy to `.env` in the repository root to override a default; every variable is optional.
# (The Vite frontend reads this root file: see `envDir` in frontend/vite.config.js.)

# --- Frontend (Vite) ---
# Where the UI sends API calls. Default: http://localhost:8000
VITE_API_URL=http://localhost:8000
# Demo sign-in. Set to "false" to skip the login page and behave exactly as before. Default: true
VITE_REQUIRE_LOGIN=true

# --- Backend (set in the host's environment; the backend does not read .env files) ---
# Browser origins allowed to call the API, comma-separated. Default: http://localhost:5173
# For a deployed frontend add its URL, e.g. CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173
# Database URL. Default: sqlite:///./reesolve.db (a file in backend/)
# DB_URL=sqlite:///./reesolve.db
# Load the 12-incident demo seed on startup when the database is empty (set on hosts with an ephemeral disk).
# AUTO_SEED=true
# No secrets or API keys are required: the demo runs fully offline on SQLite (backend/reesolve.db).
# The optional LLM intake described in CONTEXT.md section 12 is NOT built in this version; if it is added,
# its key would be set here as ANTHROPIC_API_KEY=<your-key-here>, and must never be committed.
